# 统一换行符，避免 Windows/Linux 之间产生无意义的差异
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary

# 文本文件强制 LF
*.py text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.txt text eol=lf
*.ini text eol=lf

# 让 git diff 把 json 当作结构化文本展示
*.json diff=json
